TZ=Europe/London
NODE_ENV=production
SPARKY_FITNESS_LOG_LEVEL=info

# Database
SPARKY_FITNESS_DB_NAME=sparkyfitness
SPARKY_FITNESS_DB_USER=sparky
SPARKY_FITNESS_DB_PASSWORD=generate_with_openssl_rand_base64_24
SPARKY_FITNESS_APP_DB_USER=sparkyapp
SPARKY_FITNESS_APP_DB_PASSWORD=generate_with_openssl_rand_base64_24
SPARKY_FITNESS_DB_HOST=sparkyfitness-db
SPARKY_FITNESS_DB_PORT=5432

# Set once - never change. Rotating the first invalidates encrypted external
# data sources; rotating the second locks out anyone who has enabled 2FA.
SPARKY_FITNESS_API_ENCRYPTION_KEY=generate_with_openssl_rand_hex_32
BETTER_AUTH_SECRET=generate_with_openssl_rand_hex_32

# Public origin - used for auth cookies and CORS, so it must match the URL you visit
SPARKY_FITNESS_FRONTEND_URL=https://fitness.sebastianastalos.com
SPARKY_FITNESS_SERVER_HOST=sparkyfitness-server
SPARKY_FITNESS_SERVER_PORT=3010

SPARKY_FITNESS_DISABLE_SIGNUP=false
SPARKY_FITNESS_ADMIN_EMAIL=you@example.com
SPARKY_FITNESS_PUBLIC_API_DOCS=false
ALLOW_PRIVATE_NETWORK_CORS=true
PUID=1000
GUID=1000
