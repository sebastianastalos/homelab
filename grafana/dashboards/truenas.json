{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "title": "TrueNAS Scale",
  "uid": "truenas-scale-v2",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Load Average",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "truenas_system_load_load1{job=\"graphite\"}",
          "legendFormat": "1m",
          "refId": "A"
        },
        {
          "expr": "truenas_system_load_load5{job=\"graphite\"}",
          "legendFormat": "5m",
          "refId": "B"
        },
        {
          "expr": "truenas_system_load_load15{job=\"graphite\"}",
          "legendFormat": "15m",
          "refId": "C"
        }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 2,
      "title": "Services CPU Usage",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "{__name__=~\"truenas_services_cpu.*\", job=\"graphite\"}",
          "legendFormat": "{{__name__}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 3,
      "title": "ZFS ARC Available",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "truenas_truenas_arcstats_avail_avail{job=\"graphite\"}",
          "legendFormat": "ARC Available",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 4,
      "title": "ZFS ARC Hit Rate",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "truenas_truenas_arcstats_ddhit_ddhit{job=\"graphite\"}",
          "legendFormat": "Demand Hits",
          "refId": "A"
        },
        {
          "expr": "truenas_truenas_arcstats_ddread_ddread{job=\"graphite\"}",
          "legendFormat": "Demand Reads",
          "refId": "B"
        }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 5,
      "title": "Network Traffic (enp3s0)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "truenas_net_enp3s0_received{job=\"graphite\"}",
          "legendFormat": "Received",
          "refId": "A"
        },
        {
          "expr": "truenas_net_enp3s0_sent{job=\"graphite\"}",
          "legendFormat": "Sent",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bps" } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 6,
      "title": "Network Traffic (tailscale0)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "truenas_net_tailscale0_received{job=\"graphite\"}",
          "legendFormat": "Received",
          "refId": "A"
        },
        {
          "expr": "truenas_net_tailscale0_sent{job=\"graphite\"}",
          "legendFormat": "Sent",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bps" } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    }
  ]
}
