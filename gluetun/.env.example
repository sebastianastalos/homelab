TZ=Europe/London

# Proton: account.protonvpn.com -> Downloads -> WireGuard configuration, NetShield off
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=<proton-wireguard-private-key>
SERVER_COUNTRIES=United Kingdom
FIREWALL_OUTBOUND_SUBNETS=192.168.1.0/24

# Tailscale exit node sharing gluetun's network
TS_AUTHKEY=<tailscale-auth-key>
TS_HOSTNAME=proton
TS_EXTRA_ARGS=--advertise-exit-node
TS_AUTH_ONCE=true
