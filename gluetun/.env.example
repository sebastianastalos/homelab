TZ=Europe/London

# Proton: account.protonvpn.com -> Downloads -> WireGuard configuration, NetShield off
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=<proton-wireguard-private-key>
SERVER_COUNTRIES=United Kingdom
# Plain UK servers only; gluetun can't exclude Secure Core (IS-UK/SE-UK/CH-UK) otherwise
SERVER_NAMES=UK#230,UK#234,UK#330,UK#424,UK#469,UK#534,UK#569,UK#634,UK#638,UK#665,UK#696,UK#734,UK#769,UK#838,UK#865,UK#882
FIREWALL_OUTBOUND_SUBNETS=192.168.1.0/24
# Dispatcharr UI/streams, published on the gluetun container
FIREWALL_INPUT_PORTS=9191

# Tailscale exit node sharing gluetun's network
TS_AUTHKEY=<tailscale-auth-key>
TS_HOSTNAME=proton
TS_EXTRA_ARGS=--advertise-exit-node
TS_AUTH_ONCE=true
